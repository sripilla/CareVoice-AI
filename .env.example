# CareVoice AI environment overrides.
# Copy to `.env` and edit. Every value here is optional -- config.py
# holds working defaults for all of them.

# ----------------------------------------------------------
# Pipeline
# ----------------------------------------------------------

# Which speech-to-English front end to use.
#
#   cascade   Whisper -> NLLB. Two stages, so an ASR slip becomes a
#             confidently wrong English phrase. This is the default
#             and the behaviour the project shipped with.
#
#   seamless  SeamlessM4T v2 translates speech straight to English.
#             No intermediate transcript means no compounding error.
#             Recommended for Indian languages. Runs on MPS/CUDA.
#
#   indic     Whisper -> IndicTrans2. Better translator, but still a
#             cascade. IndicTrans2 is a gated HF repo: accept its
#             terms while signed in, then set HF_TOKEN.
#
# CAREVOICE_PIPELINE=seamless

# ----------------------------------------------------------
# Compute
# ----------------------------------------------------------

# auto picks cuda -> mps -> cpu. Override with cuda / mps / cpu.
# CAREVOICE_DEVICE=auto

# auto resolves to float16 on CUDA and float32 on MPS/CPU.
# On Apple Silicon, float16 is faster but has been known to produce
# NaNs in some seq2seq stacks -- change it only if you verify output.
# CAREVOICE_DTYPE=auto

# REQUIRED on Apple Silicon: MPS does not implement every PyTorch op.
# PYTORCH_ENABLE_MPS_FALLBACK=1

# ----------------------------------------------------------
# Speech Recognition
# ----------------------------------------------------------

# Faster-Whisper model size. The default "medium" keeps CPU inference
# and the first-run download manageable. Use "large-v3" for demos and
# any accuracy evaluation -- it is meaningfully better on Telugu,
# Kannada and other Indian languages.
# CAREVOICE_WHISPER_MODEL=large-v3

# "cpu" or "cuda".
# CAREVOICE_WHISPER_DEVICE=cpu

# "int8" for CPU, "float16" for CUDA.
# CAREVOICE_WHISPER_COMPUTE_TYPE=int8

# ----------------------------------------------------------
# Storage
# ----------------------------------------------------------

# CAREVOICE_DATABASE_PATH=database/carevoice.db

# ----------------------------------------------------------
# Dashboard -> API
# ----------------------------------------------------------

# Where the Streamlit dashboard reaches the FastAPI backend.
# CAREVOICE_API_URL=http://127.0.0.1:8000

# Seconds the dashboard waits for /analyze. On CPU with large-v3 the
# bundled 30-second sample takes ~320s, so the default is deliberately
# generous. Lower it on a GPU machine.
# CAREVOICE_API_TIMEOUT=1800
